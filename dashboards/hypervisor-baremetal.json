{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "title": "Hypervisor - Bare Metal (IPMI)",
  "uid": "baremetal-hypervisor",
  "tags": ["baremetal", "ipmi", "proxmox"],
  "timezone": "browser",
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": "label_values(ipmi_up, host)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "BMC reachable",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "targets": [
        {"expr": "ipmi_up{host='$host'}", "legendFormat": "ipmi", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red", "index": 0},
                                          "1": {"text": "UP", "color": "green", "index": 1}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Sensors not nominal",
      "description": "ipmi_sensor_state: 0 nominal, 1 warning, 2 critical. Cheapest single catch-all for voltages, temps and chassis intrusion.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "targets": [
        {"expr": "count(ipmi_sensor_state{host='$host'} > 0) or vector(0)", "legendFormat": "sensors", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 1},
            {"color": "red", "value": 3}
          ]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "CPU temp",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "targets": [
        {"expr": "ipmi_temperature_celsius{host='$host', name='CPU Temp'}", "legendFormat": "cpu", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 90}
          ]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "targets": [
        {"expr": "time() - node_boot_time_seconds{host='$host'}", "legendFormat": "uptime", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Remote write backlog",
      "description": "Samples queued on the agent. Sustained growth means the tunnel to the central Prometheus is failing.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "targets": [
        {"expr": "sum(prometheus_remote_storage_samples_pending{host='$host'})", "legendFormat": "pending", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 5000}
          ]}
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Thermals & Fans",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Temperatures",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "ipmi_temperature_celsius{host='$host'}", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 85}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Fan speed",
      "description": "40mm chassis fans. Full Speed tops out near 16000 RPM, so ~7500 in Optimal is roughly half range - high absolute numbers are normal for this form factor.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "ipmi_fan_speed_rpm{host='$host'}", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Voltages",
      "description": "Collected for post-mortem value. Alert on ipmi_sensor_state instead of thresholding each rail.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [
        {"expr": "ipmi_voltage_volts{host='$host'}", "legendFormat": "{{name}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "CPU package power (RAPL)",
      "description": "Package + DRAM domains only. This board exposes no platform power sensor, so this is NOT total system draw - chipset, NICs, fans and PSU losses are excluded.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {"expr": "rate(node_rapl_package_joules_total{host='$host'}[5m])", "legendFormat": "package", "refId": "A"},
        {"expr": "rate(node_rapl_dram_joules_total{host='$host'}[5m])", "legendFormat": "dram", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "row",
      "title": "Host & Guests",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "targets": [
        {"expr": "100 - (avg(rate(node_cpu_seconds_total{host='$host', mode='idle'}[5m])) * 100)", "legendFormat": "busy", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "targets": [
        {"expr": "node_memory_MemTotal_bytes{host='$host'} - node_memory_MemAvailable_bytes{host='$host'}", "legendFormat": "used", "refId": "A"},
        {"expr": "node_memory_MemTotal_bytes{host='$host'}", "legendFormat": "total", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes", "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "Running guests",
      "description": "Requires the pve scrape job (PVE_API_HOST set in .env).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "targets": [
        {"expr": "count(pve_up{host='$host', id=~'qemu/.*'} == 1) or vector(0)", "legendFormat": "VMs", "refId": "A"},
        {"expr": "count(pve_up{host='$host', id=~'lxc/.*'} == 1) or vector(0)", "legendFormat": "LXC", "refId": "B"}
      ],
      "fieldConfig": {
        "defaults": {"min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "lineInterpolation": "stepAfter"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
